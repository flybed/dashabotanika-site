# /etc/caddy/Caddyfile — dashabotanika.ru
# Caddy сам получает и продлевает сертификаты Let's Encrypt,
# как только A-записи домена указывают на этот сервер.

# HTTP/3 снова включён (Caddy по умолчанию: h1, h2, h3). Отключение 24.10 обрывы не убрало, а браузеры,
# запомнившие HTTP/3 на 30 дней (особенно Safari на телефонах), после этого бесконечно грузили страницу.

www.dashabotanika.ru {
	redir https://dashabotanika.ru{uri} permanent
}

dashabotanika.ru {
	encode zstd gzip

	# PocketBase: API (включая realtime/SSE) и админка /_/
	@pb path /api/* /_/*
	handle @pb {
		reverse_proxy 127.0.0.1:8090
	}

	# Карта сайта со всеми статьями журнала — её собирает PocketBase (pb_hooks/seo.js)
	handle /sitemap.xml {
		rewrite * /api/seo/sitemap
		reverse_proxy 127.0.0.1:8090
	}

	# Страницы сайта (адреса без расширения файла) — сразу с текстом, заголовком и описанием
	# для поисковиков и превью ссылок. Скрипт сайта потом рисует страницу как обычно.
	@page {
		method GET
		not path_regexp \.[A-Za-z0-9]+$
	}
	handle @page {
		rewrite * /api/seo/page
		reverse_proxy 127.0.0.1:8090 {
			header_up X-Seo-Path {http.request.orig_uri.path}
		}
	}

	# Статический сайт из репозитория
	handle {
		root * /srv/dashabotanika/site
		try_files {path} /index.html
		file_server
	}

	# Если PocketBase недоступен — страница всё равно открывается (без готового текста)
	handle_errors {
		@down expression `{err.status_code} in [502, 503, 504]`
		handle @down {
			root * /srv/dashabotanika/site
			rewrite * /index.html
			file_server
		}
	}

	@img path /img/*
	header @img Cache-Control "public, max-age=604800"

	# Страница, скрипты и стили: браузер каждый раз сверяется с сервером (ETag → 304),
	# поэтому обновления сайта видны сразу, без «жёсткой» перезагрузки.
	@fresh not path /img/* /api/* /_/*
	header @fresh Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output file /var/log/caddy/dashabotanika.log
	}
}
